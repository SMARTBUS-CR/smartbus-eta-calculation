# Operational Dashboard service URL.
TRIP_CONTEXT_BASE_URL=http://127.0.0.1:8000

# Timeout applied to HTTP connection, read, write and pool operations.
TRIP_CONTEXT_TIMEOUT_SECONDS=3.0

# The batch arrivals endpoint forwards the active user's Sanctum Bearer token
# to Dashboard. Do not configure ETA_SERVICE_KEY or any static shared secret.
#
# TRIP_CONTEXT_TOKEN is optional and is only a fallback for direct provider use.
# Leave it unset for the normal request-scoped Sanctum integration.
# TRIP_CONTEXT_TOKEN=

# Inclusive quality limits for the batch arrivals API.
ETA_MAX_OBSERVATION_AGE_SECONDS=30
ETA_MAX_FUTURE_SKEW_SECONDS=5
ETA_MAX_ACCURACY_METERS=100
ETA_MAX_EFFECTIVE_SPEED_AGE_SECONDS=30
